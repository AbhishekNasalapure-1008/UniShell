# UniShell .gitignore

# --- compiled output (never commit binaries) ---
bin/
*.o
*.out
*.exe

# --- runtime scratch data ---
sandbox/*
!sandbox/.gitkeep
logs/*
!logs/.gitkeep

# --- temporary files ---
*.tmp
*.swp
*~

# --- python (web backend) ---
backend/.venv/
__pycache__/
*.pyc

# --- editors ---
.vscode/
.idea/
